# Copy this to .env (gitignored, never commit real values) and fill in a
# Spotify Developer app's credentials: https://developer.spotify.com/dashboard
# -> Create app (redirect URI doesn't matter, only Client Credentials flow is
# used, for catalog search — no user login/consent needed).
#
# These stay server-side: docker compose passes them to the container at
# runtime, and its nginx adds them to requests to Spotify's token endpoint
# (/api/spotify-token). `npm run dev` reads the same file and does the same
# thing through vite's dev-server proxy. Changing them only needs
# `docker compose up -d`, not a rebuild.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Web push (push/ service). Generate the VAPID pair once with
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# and a random PUSH_SECRET (e.g. `openssl rand -hex 24`); HA's
# rest_command.dashboard_push sends it as the x-push-secret header.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SECRET=

# Door/window-open push alerts (push/doors.mjs). A long-lived access token from
# HA (profile -> Security -> Long-lived access tokens) lets the push service
# watch the door sensors itself, so alerts arrive with the app closed. Leave
# empty to disable. Sensors and labels default to the ones in curatedHome.tsx;
# override with DOOR_SENSORS="binary_sensor.x=Label,binary_sensor.y=Label" in
# the push service's environment if they change.
# DOOR_OFFLINE_MINUTES: a sensor that stops reporting for this long gets its
# own "sensor is offline" alert (0 turns that off).
PUSH_HA_TOKEN=
DOOR_ALERT_MINUTES=2
DOOR_REPEAT_MINUTES=10
DOOR_OFFLINE_MINUTES=10
